# MultiTranslate Environment Variables Configuration

# Default Translation Engine Provider (options: 'google-free', 'google-cloud', 'deepl', 'libre', 'ai', 'mymemory')
# Default 'google-free' works immediately out of the box with zero API keys required!
TRANSLATION_PROVIDER=google-free

# Optional: Google Cloud Translation API v2 key
GOOGLE_TRANSLATE_API_KEY=

# Optional: DeepL API Key (supports free key ending with :fx or pro key)
DEEPL_API_KEY=

# Optional: Google Gemini API key for AI Contextual Translation and Multimodal Image OCR
GEMINI_API_KEY=

# Optional: OpenAI API key
OPENAI_API_KEY=

# Optional: Self-hosted or custom LibreTranslate instance URL
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
